function [sigma_RTN, P_r_RTN] = computeAlongTrackSigmaLTM()
% computeAlongTrackSigmaLTM
%   Compute 1-sigma along-track position uncertainty at LTM
%   using the 0–14 d batch covariance.
%
% OUTPUTS
%   sigma_RTN : [sigma_R, sigma_T, sigma_N] in km
%   P_r_RTN   : 3x3 position covariance in RTN at LTM (km^2)

    % ----- 0. Get constants, initial state and times -----
    [params, sc, st, X0, P0] = projectInit(); %#ok<ASGLU>
    [ET0, LTM, LCM]          = initTime();    %#ok<ASGLU>

    % ----- 1. Run 0–14 d batch in ekf_k mode (no plots) -----
    opts            = struct();
    opts.maxIter    = 11;         % use  final choice here
    opts.earlyMode  = "drop";     % match  final settings
    opts.earlyDays  = 2;
    opts.earlyScale = 10;
    opts.makePlots  = false;

    out = runBatchLSQ("0to14","ekf_k",opts);

    deltaX0 = out.X_est - X0;
    P_final = out.P_est;

    % ----- 2. Build X0fit like in Monte Carlo -----
    X0fit = X0 + deltaX0;

    % If you froze k_SRP to the EKF-derived value in the main script,
    % do the same thing here so everything is consistent:
    X0fit(7) = 0.6996824;   % <-- update this if your final EKF k_SRP changed

    Pfit = P_final;         % posterior covariance at ET0 (10x10)

    % ----- 3. Propagate state+STM from ET0 to LTM -----
    odeOpts = odeset('RelTol',1e-11,'AbsTol',1e-13);
    odeFun  = @(t,X) projectDynamics(t, X, params, sc);

    % augmented initial state: [state; vec(I_10)]
    X_aug0 = [X0fit; reshape(eye(10),100,1)];

    [~, X_aug] = ode45(odeFun, [ET0 LTM], X_aug0, odeOpts);
    X_LTM_aug  = X_aug(end,:).';

    % Extract STM Phi(ET0->LTM)
    Phi_LTM = reshape(X_LTM_aug(11:end),10,10);

    % ----- 4. Covariance at LTM in inertial frame -----
    P_LTM = Phi_LTM * Pfit * Phi_LTM.';
    P_LTM = 0.5 * (P_LTM + P_LTM.');   % enforce symmetry

    % Position-only covariance (Sun-centered inertial)
    P_r_inertial = P_LTM(1:3,1:3);

    % ----- 5. Build Earth-centered RTN triad at LTM -----
    % Earth state wrt Sun in the same frame used by projectDynamics
    xEarth = cspice_spkezr('EARTH', LTM, 'ECLIPJ2000', 'NONE', 'SUN');
    r_e    = xEarth(1:3).';
    v_e    = xEarth(4:6).';

    % Spacecraft state at LTM
    r_sc = X_LTM_aug(1:3);
    v_sc = X_LTM_aug(4:6);

    % Relative to Earth (this is what matters for the LTM requirement)
    r_rel = r_sc - r_e;    % km
    v_rel = v_sc - v_e;    % km/s

    % RTN unit vectors: R (radial), T (along-track), N (normal)
    rhat = r_rel / norm(r_rel);
    h    = cross(r_rel, v_rel);
    zhat = h / norm(h);
    that = cross(zhat, rhat);   % along-track

    % Rotation from inertial -> RTN
    R_RTN_INERTIAL = [rhat.'; that.'; zhat.'];

    % ----- 6. Transform covariance and pull sigmas -----
    P_r_RTN = R_RTN_INERTIAL * P_r_inertial * R_RTN_INERTIAL.';
    P_r_RTN = 0.5 * (P_r_RTN + P_r_RTN.');   % symmetry cleanup

    sigma_RTN = sqrt(max(diag(P_r_RTN),0));
    sigma_R   = sigma_RTN(1);
    sigma_T   = sigma_RTN(2);   % along-track
    sigma_N   = sigma_RTN(3);

    % ----- 7. Print summary -----
    fprintf('\n---- LTM Position Uncertainty (from 0–14d batch cov) ----\n');
    fprintf('1-sigma radial      = %8.3f km\n', sigma_R);
    fprintf('1-sigma along-track = %8.3f km\n', sigma_T);
    fprintf('1-sigma cross-track = %8.3f km\n', sigma_N);
    fprintf('Transverse requirement (1-sigma) = %6.1f km\n', params.sigmaTransverse);

    if sigma_T < params.sigmaTransverse
        fprintf('=> Requirement MET in linear covariance sense.\n');
    else
        fprintf('=> Requirement NOT met in linear covariance sense.\n');
    end
end
